# Copy to .env and fill in your values. NEVER commit .env.
#
# Variable names here must match what the code reads. If you rename one,
# tests/unit/test_symbols_and_config.py will not catch it — the bot will simply
# start without the credential and fail at the broker.

# ── Fyers API ─────────────────────────────────────────────────
# From https://myapi.fyers.in/dashboard/ — the app ID looks like ABCD1234-100.
FYERS_CLIENT_ID=YOUR_CLIENT_ID_HERE
FYERS_SECRET_ID=YOUR_SECRET_ID_HERE
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html

# Optional. Normally left unset: the bot caches its own token in data/ and
# refreshes it through the interactive login each morning. Set this only to
# inject a token you obtained elsewhere. It is validated before use, so a stale
# value is skipped rather than trusted.
# FYERS_ACCESS_TOKEN=

# Optional. Set to 1 in containers and CI, where no browser exists. The bot then
# raises instead of prompting for an interactive login. Leave unset on a desktop.
# FYERS_NO_INTERACTIVE=1

# ── Database ──────────────────────────────────────────────────
# DB_PASS is the canonical name — deploy/docker-compose.yml requires it and
# fails fast if it is missing. DB_PASSWORD is accepted as a fallback by the
# application, but NOT by compose, so prefer DB_PASS everywhere.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shortcircuit_trading
DB_USER=postgres
DB_PASS=YOUR_DB_PASSWORD_HERE

# ── Telegram ──────────────────────────────────────────────────
# Create the bot with @BotFather; get the chat ID by messaging it once and
# reading getUpdates. Telegram is the only operator interface — without it you
# can still trade, but you cannot see or control the bot at runtime.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# ── Optional: paths ───────────────────────────────────────────
# Overrides the repository root used to resolve data/, logs/ and reports/.
# Set this only if you run the package from outside the repository.
# SHORTCIRCUIT_ROOT=/opt/shortcircuit

# ── Not configurable here ─────────────────────────────────────
# AUTO_MODE is NOT read from the environment. It is a constant in
# src/shortcircuit/config.py, armed on boot by design, and is turned off at
# runtime with the Telegram command `/auto off`. Setting AUTO_MODE here has no
# effect whatsoever — do not rely on it to keep the bot from trading.
